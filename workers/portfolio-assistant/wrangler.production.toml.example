# Example production overlay — copy fields into Cloudflare dashboard / deploy config.
# Do not commit account_id, API tokens, or OpenAI secrets.
# Phase A: no OpenAI secret is required or expected.

name = "portfolio-assistant"
main = "src/index.js"
compatibility_date = "2026-08-01"

[vars]
# Production GitHub Pages origin(s), comma-separated — no trailing slash.
# Include local Vite origins only if you intentionally need browser CORS against a deployed Worker.
ASSISTANT_ALLOWED_ORIGINS = "https://lorenzo-natali.github.io"
